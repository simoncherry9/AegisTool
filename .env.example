# Copia a .env y rellena. NUNCA commitear .env.
# Variables con prefijo AEGISWIFI_. Anidación con "__".

AEGISWIFI_ENVIRONMENT=development
AEGIS_POLICY_ENFORCEMENT=false
AEGISWIFI_DEBUG=false
AEGISWIFI_LOG_LEVEL=INFO
AEGISWIFI_LOG_JSON=false
AEGISWIFI_API_HOST=127.0.0.1
AEGISWIFI_API_PORT=8001

# Vacío => SQLite en data/aegiswifi.db
AEGISWIFI_DATABASE__URL=

AEGISWIFI_PATHS__DATA_DIR=./data
AEGISWIFI_PATHS__EVIDENCE_DIR=./data/evidence

AEGISWIFI_SECURITY__REQUIRE_AUTH=true
# Fernet key en base64. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGISWIFI_SECURITY__ENCRYPTION_KEY_B64=

# Sistema de trabajos (Jobs)
AEGISWIFI_JOBS__MAX_WORKERS=2
AEGISWIFI_JOBS__HEARTBEAT_INTERVAL=15
AEGISWIFI_JOBS__DEFAULT_TIMEOUT=300
AEGISWIFI_JOBS__EVENT_BUFFER_SIZE=1000
AEGISWIFI_JOBS__LOG_DIR=./data/job_logs
AEGISWIFI_JOBS__PROCESS_KILL_TIMEOUT=5
